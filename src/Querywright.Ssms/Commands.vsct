<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />
  <Commands package="PackageGuid">
    <!-- Own top-level menu, between Tools and Extensions. -->
    <Menus>
      <Menu guid="CommandsGuid" id="QuerywrightMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings><ButtonText>&amp;Querywright</ButtonText><CommandName>Querywright</CommandName></Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="CommandsGuid" id="ToolsGroup" priority="0x0600">
        <Parent guid="CommandsGuid" id="QuerywrightMenu" />
      </Group>
      <!-- SSMS results-grid right-click menu (GUID_SQLEditorGroup:IDM_SQLWB_SQLRESGRID_CONTEXT, from SQLEditors.dll). -->
      <Group guid="CommandsGuid" id="GridGroup" priority="0x0600">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>
      <!-- SQL query editor right-click menu (GUID_SQLEditorGroup:IDM_SQLWB_SQLEDITOR_CONTEXT). -->
      <Group guid="CommandsGuid" id="EditorGroup" priority="0x0600">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLEDITOR_CONTEXT" />
      </Group>
      <!-- Standard toolbar (the New Query row). -->
      <Group guid="CommandsGuid" id="ToolbarGroup" priority="0xF000">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_STANDARD" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="CommandsGuid" id="AddSemicolons" priority="0x0030" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Insert semicolons</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="ExpandWildcard" priority="0x0040" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Expand wildcard</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="RenameVariable" priority="0x0050" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Rename local variable...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="CompleteSql" priority="0x0060" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Suggest from offline schema...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="FormatSql" priority="0x0070" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Format SQL selection/document</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="AnalyzeDocument" priority="0x0080" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Analyze SQL document</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="InsertSnippet" priority="0x0090" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Insert snippet...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="SnippetCheck" priority="0x0100" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Snippet smoke check</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="ApplyCasing" priority="0x0110" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Apply keyword casing</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="AddBrackets" priority="0x0120" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Add square brackets</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="RemoveBrackets" priority="0x0130" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Remove square brackets</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="QualifyNames" priority="0x0140" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Qualify object names</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="RenameAlias" priority="0x0150" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Rename table alias...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="SummarizeScript" priority="0x0160" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Summarize script</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="UnusedDeclarations" priority="0x0170" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Find unused variables and parameters</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="RefreshMetadata" priority="0x0180" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Refresh suggestions</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="ExecuteStatement" priority="0x0190" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Execute current statement</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="PickColumns" priority="0x01A0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Pick columns for *...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="TabHistory" priority="0x01B0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Icon guid="ImageCatalogGuid" id="History" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Tab history...</ButtonText><ToolTipText>Querywright: tab history (reopen closed queries)</ToolTipText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="RenameObject" priority="0x01C0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Smart rename object (script)...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="Encapsulate" priority="0x01D0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Encapsulate as stored procedure...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="FixAtCaret" priority="0x01E0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Fix issue at caret</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="FixAll" priority="0x01F0" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Fix all issues</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="GoToDefinition" priority="0x0200" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Go to definition</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="FindInvalidObjects" priority="0x0240" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Find invalid objects</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="SplitTable" priority="0x0250" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Split table (script)...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="EditFormattingStyle" priority="0x0260" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Formatting style...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="FormatFolder" priority="0x0270" type="Button">
        <Parent guid="CommandsGuid" id="ToolsGroup" />
        <Strings><ButtonText>Format SQL files in folder...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="CompareObject" priority="0x0010" type="Button">
        <Parent guid="CommandsGuid" id="EditorGroup" />
        <Strings><ButtonText>Querywright: compare object with database...</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="CopyAsIn" priority="0x0010" type="Button">
        <Parent guid="CommandsGuid" id="GridGroup" />
        <Strings><ButtonText>Querywright: copy as IN clause</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="ScriptAsInsert" priority="0x0020" type="Button">
        <Parent guid="CommandsGuid" id="GridGroup" />
        <Strings><ButtonText>Querywright: script as INSERT</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="OpenInExcel" priority="0x0030" type="Button">
        <Parent guid="CommandsGuid" id="GridGroup" />
        <Strings><ButtonText>Querywright: open in Excel</ButtonText></Strings>
      </Button>
      <Button guid="CommandsGuid" id="SaveAsCsv" priority="0x0040" type="Button">
        <Parent guid="CommandsGuid" id="GridGroup" />
        <Strings><ButtonText>Querywright: save as CSV...</ButtonText></Strings>
      </Button>
    </Buttons>
  </Commands>
  <CommandPlacements>
    <CommandPlacement guid="CommandsGuid" id="CopyAsIn" priority="0x0200">
      <Parent guid="CommandsGuid" id="ToolsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="CommandsGuid" id="ScriptAsInsert" priority="0x0210">
      <Parent guid="CommandsGuid" id="ToolsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="CommandsGuid" id="OpenInExcel" priority="0x0220">
      <Parent guid="CommandsGuid" id="ToolsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="CommandsGuid" id="SaveAsCsv" priority="0x0230">
      <Parent guid="CommandsGuid" id="ToolsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="CommandsGuid" id="CompareObject" priority="0x0280">
      <Parent guid="CommandsGuid" id="ToolsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="CommandsGuid" id="TabHistory" priority="0x0100">
      <Parent guid="CommandsGuid" id="ToolbarGroup" />
    </CommandPlacement>
  </CommandPlacements>
  <KeyBindings>
    <KeyBinding guid="CommandsGuid" id="ExecuteStatement" editor="guidVSStd97" key1="VK_F5" mod1="Shift" />
    <KeyBinding guid="CommandsGuid" id="RefreshMetadata" editor="guidVSStd97" key1="D" mod1="Control Shift" />
    <!-- Some SSMS 22 installs have no Edit.GoToDefinition and leave F12 unbound. -->
    <KeyBinding guid="CommandsGuid" id="GoToDefinition" editor="guidVSStd97" key1="VK_F12" />
  </KeyBindings>
