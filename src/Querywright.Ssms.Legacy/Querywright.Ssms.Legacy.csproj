<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same sources as Querywright.Ssms, compiled against the Visual Studio 2017 (15.x) shell that SSMS 18, 19 and 20 host (32-bit). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Querywright.Ssms</AssemblyName>
    <RootNamespace>Querywright.Ssms</RootNamespace>
    <DefineConstants>$(DefineConstants);LEGACY_SHELL</DefineConstants>
    <UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>false</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Querywright.Ssms/*.cs" />
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.ComponentModel.Composition" />
    <PackageReference Include="Microsoft.VisualStudio.Editor" Version="15.8.525" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="15.8.525" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Language" Version="15.8.525" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.ComponentModelHost" Version="15.8.525" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="15.9.28307" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="15.8.209" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../Querywright.Core/Querywright.Core.csproj" />
    <VSCTCompile Include="../Querywright.Ssms/Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-LICENSES/ScriptDOM.txt" Link="THIRD-PARTY-LICENSES/ScriptDOM.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
